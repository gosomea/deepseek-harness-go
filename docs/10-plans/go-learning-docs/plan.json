{
  "schema_version": 1,
  "id": "deepseek-harness-go-learning-docs",
  "title": "Go 视角学习文档优化与验收",
  "objectives": {
    "learning": "读者能从 Go 知识进入 Cordis 并理解 DSH 对应概念",
    "structure": "分类模板、非空章节、导航与文档归属明确",
    "examples": "完整 Go 示例可运行且输出验证，片段明确分类",
    "validation": "拒绝样例与原有全部门禁通过，证据与 CI 如实记录"
  },
  "constraints": [
    "原 DSH 只读",
    "保留现有覆盖率与竞态门禁",
    "语义审阅 independent=false",
    "推送后核对对应提交三平台 CI"
  ],
  "documents": [
    "docs/10-plans/go-learning-docs/plans.md"
  ],
  "final": "acceptance",
