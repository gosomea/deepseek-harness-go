          "argv": [
            "{python}",
            "-c",
            "import json; from pathlib import Path; d=json.loads(Path('docs/10-plans/dsh-go-replication/source-inventory.json').read_text()); g=d['package_groups']; paths=[p for rows in g.values() for p in rows]; assert d['source_commit']=='00102833dfaee1da9f48a3a8eae9d34005a75218'; assert d['group_count']==len(g)==54; assert d['package_count']==len(paths)==len(set(paths))==307; assert len(d['vendor_packages'])==9; assert all(p.startswith('packages/'+k+'/') for k,rows in g.items() for p in rows); print('source inventory structure: OK; semantic source review required')"
