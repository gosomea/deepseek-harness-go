{
  "schema_version": 1,
  "id": "dsh-go-replication-m01",
  "title": "M1 Cordis 下游基础与行为对照",
  "objectives": {
    "replication": "补齐 Loader 与核心插件所需的下游运行时能力，并用固定 TS 参考的差分 trace 证明对应关系",
    "learning": "把 C01–C04 实验与差分场景对齐，让读者能预测状态、制造失败并定位两侧源码",
    "evidence": "每个行为有共享输入、两侧 trace、归一化规则和显式差异；不把规划或缺环境当作通过"
  },
  "constraints": [
    "只实现 M1 裁决的下游阻塞项；Proxy、generator 语法、模块 HMR 等不提前补",
    "DSH 参考 checkout 只读；TS 参考经固定提交的 vendor/cordis 构建产物运行，本地未提交改动不进入基线",
    "Cordis 维持零第三方运行时依赖",
    "新增包同时扩展格式、覆盖率、文档与 API 检查范围，不沿用 Cordis 单包选择器",
    "每个节点需要语义评审；独立性如实记录",
    "差异不得用归一化抹除；清理错误语义等分歧必须单独记录"
  ],
  "documents": [
    "docs/10-plans/dsh-go-replication/acceptance.md",
    "docs/10-plans/dsh-go-replication/source-inventory.json",
    "docs/10-plans/dsh-go-replication/stages/m01-cordis.md"
  ],
  "final": "m01-handover",
  "nodes": [
