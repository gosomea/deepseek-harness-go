          "id": "",
          "insert": [
            {
              "id": "greeter",
              "name": "greeter",
              "config": {
                "level": 1,
                "label": "base"
              }
            },
            {
              "id": "gate",
              "group": true,
              "config": [
                {
                  "id": "inner",
