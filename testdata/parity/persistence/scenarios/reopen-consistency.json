{
  "id": "reopen-consistency",
  "title": "落盘后用新实例重开，得到相同历史与相同的待处理状态",
  "events": [
    { "type": "turn/start", "data": { "turn": 0, "input": "read a.txt" } },
    { "type": "user/message", "message": { "id": "m1", "role": "user", "text": "read a.txt" }, "surface": "append" },
    { "type": "step/start", "data": { "turn": 0, "step": 0 } },
    { "type": "request/header", "data": { "turn": 0, "step": 0, "provider": "fake", "model": "fake-1", "messages": 1 } },
    { "type": "tool/call", "data": { "turn": 0, "step": 0, "callId": "call-1", "name": "read_file", "arguments": "{}" } }
  ],
  "expect": {
    "complete": 5,
    "repairable": false,
    "openTurn": true,
    "unsettled": ["call-1"],
    "pendingInputs": 0,
    "needsAttention": true,
    "historyRoles": ["user"]
  }
}
